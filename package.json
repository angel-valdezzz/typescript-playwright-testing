{
  "name": "typescript-playwright-testing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test",
    "check": "tsc --noEmit",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "report": "playwright show-report"
  },
  "dependencies": {
    "@playwright/test": "1.56.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.10.2"
  }
}
